.env
.env.local
.env.*.local

# エディタ・OS
.DS_Store
*.log

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Claude Code の内部状態ファイル（スケジュールタスク・worktree管理等）
.claude/
